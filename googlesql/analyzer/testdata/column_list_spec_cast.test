[default language_features=MAXIMUM,+COLUMN_LIST_SPEC]
[default show_sqlbuilder_output]
[default use_constant_evaluator]
[default sql_builder_target_syntax_mode=standard]


[mode=expression]
CAST(NULL AS COLUMN_LIST_SPEC)

--
Literal(type=COLUMN_LIST_SPEC, value=NULL, has_explicit_type=TRUE)

[SQLBUILDER_OUTPUT]
CAST(NULL AS COLUMN_LIST_SPEC)
==

[mode=expression]
CAST(NULL AS ARRAY<COLUMN_LIST_SPEC>)

--
Literal(type=ARRAY<COLUMN_LIST_SPEC>, value=NULL, has_explicit_type=TRUE)

[SQLBUILDER_OUTPUT]
CAST(NULL AS ARRAY<COLUMN_LIST_SPEC>)
==

SELECT CAST(NULL AS ARRAY<COLUMN_LIST_SPEC>) IS NULL;

--
QueryStmt
+-output_column_list=
| +-$query.$col1#1 AS `$col1` [BOOL]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1]
    +-expr_list=
    | +-$col1#1 :=
    |   +-FunctionCall(GoogleSQL:$is_null(ARRAY<COLUMN_LIST_SPEC>) -> BOOL)
    |     +-Literal(type=ARRAY<COLUMN_LIST_SPEC>, value=NULL, has_explicit_type=TRUE)
    +-input_scan=
      +-SingleRowScan

[SQLBUILDER_OUTPUT]
SELECT
  CAST(NULL AS ARRAY< COLUMN_LIST_SPEC >) IS NULL AS a_1;
==

[allow_undeclared_parameters]
[parameter_mode=named]
