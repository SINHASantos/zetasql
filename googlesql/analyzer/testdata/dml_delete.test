# Basic DELETE with USING single table and show_sqlbuilder_output
[show_sqlbuilder_output]
[language_features={{MAXIMUM|MAXIMUM,+DML_DELETE_WITH_JOIN}}]
DELETE SimpleTypes USING KeyValue WHERE SimpleTypes.int64 = KeyValue.Key
--
ALTERNATION GROUP: MAXIMUM
--
ERROR: DELETE with USING clause is not supported [at 1:20]
DELETE SimpleTypes USING KeyValue WHERE SimpleTypes.int64 = KeyValue.Key
                   ^
--
ALTERNATION GROUP: MAXIMUM,+DML_DELETE_WITH_JOIN
--
DeleteStmt
+-table_scan=
| +-TableScan(column_list=[SimpleTypes.int64#2], table=SimpleTypes, column_index_list=[1])
+-column_access_list=READ
+-where_expr=
| +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
|   +-ColumnRef(type=INT64, column=SimpleTypes.int64#2)
|   +-ColumnRef(type=INT64, column=KeyValue.Key#20)
+-using_scan=
  +-TableScan(column_list=[KeyValue.Key#20], table=KeyValue, column_index_list=[0])

[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
DELETE SimpleTypes AS simpletypes_1
USING
  KeyValue
WHERE
  (simpletypes_1.int64) = (KeyValue.Key);

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
DELETE SimpleTypes AS simpletypes_1
USING
  (
    FROM
      KeyValue
    |> SELECT
         KeyValue.Key AS a_2
    |> AS keyvalue_3
  )
WHERE
  (simpletypes_1.int64) = (keyvalue_3.a_2);
==

