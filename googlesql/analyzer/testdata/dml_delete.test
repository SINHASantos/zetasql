# DELETE with USING comma joins
[language_features=MAXIMUM,+DML_DELETE_WITH_JOIN]
[show_sqlbuilder_output]
DELETE SimpleTypes USING KeyValue, ComplexTypes WHERE SimpleTypes.int64 = KeyValue.Key AND KeyValue.Key = ComplexTypes.key
--
DeleteStmt
+-table_scan=
| +-TableScan(column_list=[SimpleTypes.int64#2], table=SimpleTypes, column_index_list=[1])
+-column_access_list=READ
+-where_expr=
| +-FunctionCall(GoogleSQL:$and(BOOL, repeated(1) BOOL) -> BOOL)
|   +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
|   | +-ColumnRef(type=INT64, column=SimpleTypes.int64#2)
|   | +-ColumnRef(type=INT64, column=KeyValue.Key#20)
|   +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
|     +-ColumnRef(type=INT64, column=KeyValue.Key#20)
|     +-Cast(INT32 -> INT64)
|       +-ColumnRef(type=INT32, column=ComplexTypes.key#22)
+-using_scan=
  +-JoinScan
    +-column_list=[KeyValue.Key#20, ComplexTypes.key#22]
    +-left_scan=
    | +-TableScan(column_list=[KeyValue.Key#20], table=KeyValue, column_index_list=[0])
    +-right_scan=
      +-TableScan(column_list=[ComplexTypes.key#22], table=ComplexTypes, column_index_list=[0])

[SQLBUILDER_TARGET_SYNTAX_MODE standard]
[SQLBUILDER_OUTPUT]
DELETE SimpleTypes AS simpletypes_1
USING
  (
    SELECT
      KeyValue.Key AS a_2
    FROM
      KeyValue
  ) AS keyvalue_3
  CROSS JOIN
  (
    SELECT
      ComplexTypes.key AS a_4
    FROM
      ComplexTypes
  ) AS complextypes_5
WHERE
  ((simpletypes_1.int64) = (keyvalue_3.a_2)) AND ((keyvalue_3.a_2) = CAST(complextypes_5.a_4 AS INT64));

[SQLBUILDER_TARGET_SYNTAX_MODE pipe]
[SQLBUILDER_OUTPUT]
DELETE SimpleTypes AS simpletypes_1
USING
  (
    FROM
      KeyValue
    |> SELECT
         KeyValue.Key AS a_2
    |> AS keyvalue_3
    |> CROSS JOIN
       (
         FROM
           ComplexTypes
         |> SELECT
              ComplexTypes.key AS a_4
         |> AS complextypes_5
       )
    |> SELECT
         keyvalue_3.a_2 AS a_2,
         complextypes_5.a_4 AS a_4
    |> AS joinscan_6
  )
WHERE
  ((simpletypes_1.int64) = (joinscan_6.a_2)) AND ((joinscan_6.a_2) = CAST(joinscan_6.a_4 AS INT64));
==

# DELETE with USING subquery
[language_features=MAXIMUM,+DML_DELETE_WITH_JOIN]
[show_sqlbuilder_output]
DELETE SimpleTypes USING (SELECT 1 AS a) WHERE SimpleTypes.int64 = a
--
DeleteStmt
+-table_scan=
| +-TableScan(column_list=[SimpleTypes.int64#2], table=SimpleTypes, column_index_list=[1])
+-column_access_list=READ
+-where_expr=
| +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
|   +-ColumnRef(type=INT64, column=SimpleTypes.int64#2)
|   +-ColumnRef(type=INT64, column=$subquery1.a#20)
+-using_scan=
  +-ProjectScan
    +-column_list=[$subquery1.a#20]
