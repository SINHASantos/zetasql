| +-TableScan(column_list=[SimpleTypes.int64#2], table=SimpleTypes, column_index_list=[1], alias="target")
+-column_access_list=READ
+-where_expr=
| +-FunctionCall(GoogleSQL:$and(BOOL, repeated(1) BOOL) -> BOOL)
|   +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
|   | +-ColumnRef(type=INT64, column=SimpleTypes.int64#2)
|   | +-ColumnRef(type=INT64, column=KeyValue.Key#20)
|   +-SubqueryExpr
|     +-type=BOOL
|     +-subquery_type=EXISTS
|     +-parameter_list=
|     | +-ColumnRef(type=INT64, column=KeyValue.Key#20)
|     +-subquery=
|       +-ProjectScan
|         +-column_list=[$expr_subquery.$col1#24]
|         +-expr_list=
|         | +-$col1#24 := Literal(type=INT64, value=1)
|         +-input_scan=
|           +-FilterScan
|             +-column_list=[KeyValue.Key#22]
|             +-input_scan=
|             | +-TableScan(column_list=[KeyValue.Key#22], table=KeyValue, column_index_list=[0])
|             +-filter_expr=
|               +-FunctionCall(GoogleSQL:$equal(INT64, INT64) -> BOOL)
|                 +-ColumnRef(type=INT64, column=KeyValue.Key#22)
|                 +-ColumnRef(type=INT64, column=KeyValue.Key#20, is_correlated=TRUE)
+-using_scan=
  +-TableScan(column_list=[KeyValue.Key#20], table=KeyValue, column_index_list=[0], alias="source")

