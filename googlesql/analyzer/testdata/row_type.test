# Select a column from the ROW table.
FROM KeyValueLazy kv
|> LIMIT 1
|> SELECT kv.key
|> LIMIT 2
--
QueryStmt
+-output_column_list=
| +-$pipe_select.key#2 AS key [INT64]
+-query=
  +-LimitOffsetScan
    +-column_list=[$pipe_select.key#2]
    +-input_scan=
    | +-ProjectScan
    |   +-column_list=[$pipe_select.key#2]
    |   +-expr_list=
    |   | +-key#2 :=
    |   |   +-GetRowField
    |   |     +-type=INT64
    |   |     +-expr=
    |   |     | +-ColumnRef(type=ROW<KeyValueLazy>, column=KeyValueLazy.$row#1)
    |   |     +-column=KeyValueLazy.Key
    |   +-input_scan=
    |     +-LimitOffsetScan
    |       +-column_list=[KeyValueLazy.$row#1]
    |       +-input_scan=
    |       | +-TableScan(column_list=[KeyValueLazy.$row#1], table=KeyValueLazy, alias="kv", read_as_row_type=TRUE)
    |       +-limit=
    |         +-Literal(type=INT64, value=1)
    +-limit=
      +-Literal(type=INT64, value=2)

[REWRITTEN AST]
QueryStmt
+-output_column_list=
| +-$pipe_select.key#2 AS key [INT64]
+-query=
  +-LimitOffsetScan
    +-column_list=[$pipe_select.key#2]
    +-input_scan=
