  FROM tvf_returning_row_type_recursive_nested()
  |> SELECT row_col.middle AS my_row
)
FROM cte |> SELECT my_row.middle.key AS k1
|> CROSS JOIN (FROM cte |> SELECT my_row.middle.key AS k2)
|> EXTEND (FROM cte |> SELECT my_row.middle.key) AS k3
