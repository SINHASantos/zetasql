SELECT * EXCEPT (**COLUMNS(['Key', 'Value'])) FROM KeyValue
--
ERROR: SELECT * expands to zero columns after applying EXCEPT [at 1:8]
SELECT * EXCEPT (**COLUMNS(['Key', 'Value'])) FROM KeyValue
       ^
==

SELECT * EXCEPT (**COLUMNS(['Key']), **COLUMNS(['Value'])) FROM KeyValue

--
ERROR: SELECT * expands to zero columns after applying EXCEPT [at 1:8]
SELECT * EXCEPT (**COLUMNS(['Key']), **COLUMNS(['Value'])) FROM KeyValue
       ^
==

SELECT * EXCEPT (**COLUMNS(['Key']), Value) FROM KeyValue
--
ERROR: SELECT * expands to zero columns after applying EXCEPT [at 1:8]
SELECT * EXCEPT (**COLUMNS(['Key']), Value) FROM KeyValue
       ^
==

SELECT * EXCEPT (**COLUMNS([])) FROM KeyValue
--
QueryStmt
+-output_column_list=
| +-KeyValue.Key#1 AS Key [INT64]
| +-KeyValue.Value#2 AS Value [STRING]
+-query=
  +-ProjectScan
    +-column_list=KeyValue.[Key#1, Value#2]
    +-input_scan=
      +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])

[SQLBUILDER_OUTPUT]
SELECT
  KeyValue.Key AS Key,
  KeyValue.Value AS Value
FROM
  KeyValue;
==

SELECT * EXCEPT (**COLUMNS(['a'])) FROM (select Key as a, Value as b from KeyValue)
--
QueryStmt
+-output_column_list=
| +-KeyValue.Value#2 AS b [STRING]
+-query=
  +-ProjectScan
    +-column_list=[KeyValue.Value#2]
    +-input_scan=
      +-ProjectScan
        +-column_list=KeyValue.[Key#1, Value#2]
        +-input_scan=
          +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])

[SQLBUILDER_OUTPUT]
SELECT
  projectscan_3.a_2 AS b
FROM
  (
    SELECT
      KeyValue.Key AS a_1,
      KeyValue.Value AS a_2
    FROM
      KeyValue
  ) AS projectscan_3;
==

