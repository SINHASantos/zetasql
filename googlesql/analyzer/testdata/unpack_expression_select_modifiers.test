# Unpack a field from the proto value column
SELECT * EXCEPT (**COLUMNS(['value'])) FROM TestBcPBValueProtoTable v
--
QueryStmt
+-output_column_list=
| +-TestBcPBValueProtoTable.Filename#2 AS Filename [STRING]
| +-TestBcPBValueProtoTable.RowId#3 AS RowId [INT64]
+-query=
  +-ProjectScan
    +-column_list=TestBcPBValueProtoTable.[Filename#2, RowId#3]
    +-input_scan=
      +-TableScan(column_list=TestBcPBValueProtoTable.[Filename#2, RowId#3], table=TestBcPBValueProtoTable, column_index_list=[1, 2], alias="v")

[SQLBUILDER_OUTPUT]
SELECT
  TestBcPBValueProtoTable.Filename AS Filename,
  TestBcPBValueProtoTable.RowId AS RowId
FROM
  TestBcPBValueProtoTable;

==

