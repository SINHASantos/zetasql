[default language_features=MAXIMUM,+COLUMN_LIST_SPEC]
[default show_sqlbuilder_output]
[default sql_builder_target_syntax_mode=pipe]

FROM KeyValue |> DROP **COLUMNS(['Key'])
--
QueryStmt
+-output_column_list=
| +-KeyValue.Value#2 AS Value [STRING]
+-query=
  +-TableScan(column_list=[KeyValue.Value#2], table=KeyValue, column_index_list=[1])

[SQLBUILDER_OUTPUT]
FROM
  KeyValue
|> SELECT
     KeyValue.Value AS Value;
==

FROM KeyValue |> DROP **COLUMNS(ARRAY['Key'])
--
QueryStmt
+-output_column_list=
| +-KeyValue.Value#2 AS Value [STRING]
+-query=
  +-TableScan(column_list=[KeyValue.Value#2], table=KeyValue, column_index_list=[1])

[SQLBUILDER_OUTPUT]
FROM
  KeyValue
|> SELECT
     KeyValue.Value AS Value;
==

FROM KeyValue |> DROP **COLUMNS(['Key', 'Value'])

--
ERROR: Pipe DROP dropped all columns in the input table [at 1:15]
FROM KeyValue |> DROP **COLUMNS(['Key', 'Value'])
              ^
==

FROM Account |> DROP id, **COLUMNS(['balance'])
--
QueryStmt
+-output_column_list=
| +-Account.name#2 AS name [STRING]
+-query=
  +-TableScan(column_list=[Account.name#2], table=Account, column_index_list=[1])

[SQLBUILDER_OUTPUT]
FROM
  Account
|> SELECT
     Account.name AS name;
==

FROM Account |> DROP **COLUMNS(['balance']), name
--
QueryStmt
+-output_column_list=
| +-Account.id#1 AS id [INT64]
+-query=
  +-TableScan(column_list=[Account.id#1], table=Account, column_index_list=[0])

[SQLBUILDER_OUTPUT]
FROM
  Account
|> SELECT
     Account.id AS id;
==

FROM KeyValue |> DROP **COLUMNS([])
--
ERROR: No columns specified in pipe DROP [at 1:15]
FROM KeyValue |> DROP **COLUMNS([])
              ^
==

FROM KeyValue |> DROP Key, **COLUMNS([])
--
QueryStmt
+-output_column_list=
| +-KeyValue.Value#2 AS Value [STRING]
+-query=
  +-TableScan(column_list=[KeyValue.Value#2], table=KeyValue, column_index_list=[1])

[SQLBUILDER_OUTPUT]
FROM
  KeyValue
|> SELECT
     KeyValue.Value AS Value;
==

FROM (select Key as a, Value as b, Key as c from KeyValue) |> DROP **COLUMNS(['a', 'b'])
--
QueryStmt
+-output_column_list=
| +-KeyValue.Key#1 AS c [INT64]
+-query=
  +-ProjectScan
    +-column_list=KeyValue.[Key#1, Value#2, Key#1]
    +-input_scan=
      +-TableScan(column_list=KeyValue.[Key#1, Value#2], table=KeyValue, column_index_list=[0, 1])

[SQLBUILDER_OUTPUT]
FROM
  KeyValue
|> SELECT
     KeyValue.Key AS a_1,
     KeyValue.Value AS a_2
|> AS keyvalue_3
|> SELECT
     keyvalue_3.a_1 AS a_1,
     keyvalue_3.a_2 AS a_2,
     keyvalue_3.a_1 AS a_4
|> AS projectscan_5
|> SELECT
     projectscan_5.a_1 AS c;
==

# Duplicate column names
FROM KeyValue |> DROP **COLUMNS(['Key', 'Key'])
--
ERROR: Duplicate column name in pipe DROP: Key [at 1:23]
FROM KeyValue |> DROP **COLUMNS(['Key', 'Key'])
                      ^
==

# Unpack in Subquery
SELECT * FROM (FROM KeyValue |> DROP **COLUMNS(['Key']))
--
QueryStmt
+-output_column_list=
| +-KeyValue.Value#2 AS Value [STRING]
+-query=
  +-ProjectScan
    +-column_list=[KeyValue.Value#2]
    +-input_scan=
      +-TableScan(column_list=[KeyValue.Value#2], table=KeyValue, column_index_list=[1])

[SQLBUILDER_OUTPUT]
FROM
  KeyValue
|> SELECT
     KeyValue.Value AS Value;
==

# Case Sensitivity
FROM KeyValue |> DROP **COLUMNS(['key'])
--
QueryStmt
+-output_column_list=
| +-KeyValue.Value#2 AS Value [STRING]
+-query=
  +-TableScan(column_list=[KeyValue.Value#2], table=KeyValue, column_index_list=[1])

[SQLBUILDER_OUTPUT]
FROM
  KeyValue
|> SELECT
     KeyValue.Value AS Value;
==

