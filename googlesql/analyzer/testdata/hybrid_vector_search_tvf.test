# HYBRID_VECTOR_SEARCH TVF used in a function definition
CREATE TEMP FUNCTION OneSidedChamferDistanceHybrid(
  colA STRING,
  distance_type STRING)
RETURNS DOUBLE
AS (
  (
    SELECT AVG(distance) AS distance
    FROM
      HYBRID_VECTOR_SEARCH(
        TABLE base_table, colA,
        TABLE query_table,
        lexical_search_columns => ['string_col'],
        query_column_to_search => 'query_embedding',
        top_k => 1,
        distance_type => distance_type)
  )
);
--
CreateFunctionStmt
+-name_path=OneSidedChamferDistanceHybrid
+-create_scope=CREATE_TEMP
+-has_explicit_return_type=TRUE
+-return_type=DOUBLE
+-argument_name_list=[colA, distance_type]
+-signature=(STRING colA, STRING distance_type) -> DOUBLE
+-language="SQL"
+-code="(\n    SELECT AVG(distance) AS distance\n    FROM\n      HYBRID_VECTOR_SEARCH(\n        TABLE base_table, colA,\n        TABLE query_table,\n        lexical_search_columns => ['string_col'],\n        query_column_to_search => 'query_embedding',\n        top_k => 1,\n        distance_type => distance_type)\n  )"
+-function_expression=
  +-SubqueryExpr
    +-type=DOUBLE
    +-subquery_type=SCALAR
    +-subquery=
      +-ProjectScan
        +-column_list=[$aggregate.distance#12]
        +-input_scan=
          +-AggregateScan
            +-column_list=[$aggregate.distance#12]
            +-input_scan=
