# Call with alias

WITH base_table AS (
  SELECT 1 AS _INDEX_LEAF_ID, ARRAY<FLOAT>[1.0, 2.0, 3.0] AS EmbeddingColumn, 'text_base' AS StrCol
),
query AS (
  SELECT
    [
      STRUCT(
        CAST(1 AS INT64) AS id,
        ARRAY<FLOAT>[0.1, 0.2, 0.3] AS embd,
        'text_query1' AS q_str
      ),
      STRUCT(
        CAST(2 AS INT64) AS id,
        ARRAY<FLOAT>[0.4, 0.5, 0.6, 0.7] AS embd,
        'text_query2' AS q_str
      )
    ]
)
SELECT query.*, base._INDEX_LEAF_ID, distance
FROM HYBRID_VECTOR_SEARCH(
   (
    SELECT _INDEX_LEAF_ID, EmbeddingColumn AS embedding, StrCol AS string_col
    FROM base_table
  ),  -- Inlined base_table
  'embedding',
(SELECT id, embd, q_str FROM UNNEST(
    [
      STRUCT(
        CAST(1 AS INT64) AS id,
        ARRAY<FLOAT>[0.1, 0.2, 0.3] AS embd,
        'text_query1' AS q_str
      ),
      STRUCT(
        CAST(2 AS INT64) AS id,
        ARRAY<FLOAT>[0.4, 0.5, 0.6, 0.7] AS embd,
        'text_query2' AS q_str
      )
    ])),
  lexical_search_columns => ['string_col'],
  query_column_to_search => 'embd',
  lexical_search_query_column => 'q_str',
  top_k => 10,
  distance_type => 'DOT_PRODUCT')
--
QueryStmt
+-output_column_list=
| +-$query.id#15 AS id [INT64]
| +-$query.embd#16 AS embd [ARRAY<FLOAT>]
| +-$query.q_str#17 AS q_str [STRING]
| +-$query._INDEX_LEAF_ID#18 AS _INDEX_LEAF_ID [INT64]
| +-HYBRID_VECTOR_SEARCH.distance#14 AS distance [DOUBLE]
+-query=
  +-WithScan
    +-column_list=[$query.id#15, $query.embd#16, $query.q_str#17, $query._INDEX_LEAF_ID#18, HYBRID_VECTOR_SEARCH.distance#14]
    +-with_entry_list=
    | +-WithEntry
    | | +-with_query_name="base_table"
    | | +-with_subquery=
    | |   +-ProjectScan
    | |     +-column_list=base_table.[_INDEX_LEAF_ID#1, EmbeddingColumn#2, StrCol#3]
    | |     +-expr_list=
    | |     | +-_INDEX_LEAF_ID#1 := Literal(type=INT64, value=1)
    | |     | +-EmbeddingColumn#2 := Literal(type=ARRAY<FLOAT>, value=[1, 2, 3], has_explicit_type=TRUE)
    | |     | +-StrCol#3 := Literal(type=STRING, value="text_base")
    | |     +-input_scan=
    | |       +-SingleRowScan
    | +-WithEntry
    |   +-with_query_name="query"
    |   +-with_subquery=
    |     +-ProjectScan
    |       +-column_list=[query.$col1#4]
    |       +-expr_list=
    |       | +-$col1#4 :=
    |       |   +-FunctionCall(GoogleSQL:$make_array(repeated(2) STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>) -> ARRAY<STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>>)
    |       |     +-MakeStruct
    |       |     | +-type=STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>
    |       |     | +-field_list=
    |       |     |   +-Literal(type=INT64, value=1, has_explicit_type=TRUE)
    |       |     |   +-Literal(type=ARRAY<FLOAT>, value=[0.1, 0.2, 0.3], has_explicit_type=TRUE)
    |       |     |   +-Literal(type=STRING, value="text_query1")
    |       |     +-MakeStruct
    |       |       +-type=STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>
    |       |       +-field_list=
    |       |         +-Literal(type=INT64, value=2, has_explicit_type=TRUE)
    |       |         +-Literal(type=ARRAY<FLOAT>, value=[0.4, 0.5, 0.6, 0.7], has_explicit_type=TRUE)
    |       |         +-Literal(type=STRING, value="text_query2")
    |       +-input_scan=
    |         +-SingleRowScan
    +-query=
      +-ProjectScan
        +-column_list=[$query.id#15, $query.embd#16, $query.q_str#17, $query._INDEX_LEAF_ID#18, HYBRID_VECTOR_SEARCH.distance#14]
        +-expr_list=
        | +-id#15 :=
        | | +-GetStructField
        | |   +-type=INT64
        | |   +-expr=
        | |   | +-ColumnRef(type=STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>, column=HYBRID_VECTOR_SEARCH.query#12)
        | |   +-field_idx=0
        | +-embd#16 :=
        | | +-GetStructField
        | |   +-type=ARRAY<FLOAT>
        | |   +-expr=
        | |   | +-ColumnRef(type=STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>, column=HYBRID_VECTOR_SEARCH.query#12)
        | |   +-field_idx=1
        | +-q_str#17 :=
        | | +-GetStructField
        | |   +-type=STRING
        | |   +-expr=
        | |   | +-ColumnRef(type=STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>, column=HYBRID_VECTOR_SEARCH.query#12)
        | |   +-field_idx=2
        | +-_INDEX_LEAF_ID#18 :=
        |   +-GetStructField
        |     +-type=INT64
        |     +-expr=
        |     | +-ColumnRef(type=STRUCT<_INDEX_LEAF_ID INT64, embedding ARRAY<FLOAT>, string_col STRING>, column=HYBRID_VECTOR_SEARCH.base#13)
        |     +-field_idx=0
        +-input_scan=
          +-TVFScan
            +-column_list=HYBRID_VECTOR_SEARCH.[query#12, base#13, distance#14]
            +-tvf=GoogleSQL:hybrid_vector_search
            +-signature=(TABLE<_INDEX_LEAF_ID INT64, embedding ARRAY<FLOAT>, string_col STRING>, literal STRING, TABLE<id INT64, embd ARRAY<FLOAT>, q_str STRING>, ARRAY<STRING>, literal STRING, literal STRING, null PROTO<googlesql_test.TestApproxDistanceFunctionOptionsProto>, literal INT64, literal STRING, null DOUBLE) -> TABLE<query STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>, base STRUCT<_INDEX_LEAF_ID INT64, embedding ARRAY<FLOAT>, string_col STRING>, distance DOUBLE>
            +-argument_list=
            | +-FunctionArgument
            | | +-scan=
            | | | +-ProjectScan
            | | |   +-column_list=base_table.[_INDEX_LEAF_ID#5, EmbeddingColumn#6, StrCol#7]
            | | |   +-input_scan=
            | | |     +-WithRefScan(column_list=base_table.[_INDEX_LEAF_ID#5, EmbeddingColumn#6, StrCol#7], with_query_name="base_table")
            | | +-argument_column_list=base_table.[_INDEX_LEAF_ID#5, EmbeddingColumn#6, StrCol#7]
            | +-FunctionArgument
            | | +-expr=
            | |   +-Literal(type=STRING, value="embedding")
            | +-FunctionArgument
            | | +-scan=
            | | | +-ProjectScan
            | | |   +-column_list=$subquery2.[id#9, embd#10, q_str#11]
            | | |   +-expr_list=
            | | |   | +-id#9 :=
            | | |   | | +-GetStructField
            | | |   | |   +-type=INT64
            | | |   | |   +-expr=
            | | |   | |   | +-ColumnRef(type=STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>, column=$array.$unnest1#8)
            | | |   | |   +-field_idx=0
            | | |   | +-embd#10 :=
            | | |   | | +-GetStructField
            | | |   | |   +-type=ARRAY<FLOAT>
            | | |   | |   +-expr=
            | | |   | |   | +-ColumnRef(type=STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>, column=$array.$unnest1#8)
            | | |   | |   +-field_idx=1
            | | |   | +-q_str#11 :=
            | | |   |   +-GetStructField
            | | |   |     +-type=STRING
            | | |   |     +-expr=
            | | |   |     | +-ColumnRef(type=STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>, column=$array.$unnest1#8)
            | | |   |     +-field_idx=2
            | | |   +-input_scan=
            | | |     +-ArrayScan
            | | |       +-column_list=[$array.$unnest1#8]
            | | |       +-array_expr_list=
            | | |       | +-FunctionCall(GoogleSQL:$make_array(repeated(2) STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>) -> ARRAY<STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>>)
            | | |       |   +-MakeStruct
            | | |       |   | +-type=STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>
            | | |       |   | +-field_list=
            | | |       |   |   +-Literal(type=INT64, value=1, has_explicit_type=TRUE)
            | | |       |   |   +-Literal(type=ARRAY<FLOAT>, value=[0.1, 0.2, 0.3], has_explicit_type=TRUE)
            | | |       |   |   +-Literal(type=STRING, value="text_query1")
            | | |       |   +-MakeStruct
            | | |       |     +-type=STRUCT<id INT64, embd ARRAY<FLOAT>, q_str STRING>
            | | |       |     +-field_list=
            | | |       |       +-Literal(type=INT64, value=2, has_explicit_type=TRUE)
            | | |       |       +-Literal(type=ARRAY<FLOAT>, value=[0.4, 0.5, 0.6, 0.7], has_explicit_type=TRUE)
            | | |       |       +-Literal(type=STRING, value="text_query2")
            | | |       +-element_column_list=[$array.$unnest1#8]
            | | +-argument_column_list=$subquery2.[id#9, embd#10, q_str#11]
            | +-FunctionArgument
            | | +-expr=
            | |   +-Literal(type=ARRAY<STRING>, value=["string_col"])
            | +-FunctionArgument
            | | +-expr=
            | |   +-Literal(type=STRING, value="embd")
            | +-FunctionArgument
            | | +-expr=
            | |   +-Literal(type=STRING, value="q_str")
            | +-FunctionArgument
            | | +-expr=
            | |   +-Literal(type=PROTO<googlesql_test.TestApproxDistanceFunctionOptionsProto>, value=NULL, preserve_in_literal_remover=TRUE)
            | +-FunctionArgument
            | | +-expr=
            | |   +-Literal(type=INT64, value=10)
            | +-FunctionArgument
            | | +-expr=
            | |   +-Literal(type=STRING, value="DOT_PRODUCT")
            | +-FunctionArgument
            |   +-expr=
            |     +-Literal(type=DOUBLE, value=NULL)
            +-column_index_list=[0, 1, 2]
            +-function_call_signature=(ANY TABLE, STRING column_to_search, ANY TABLE, ARRAY<STRING> lexical_search_columns, optional(1) STRING query_column_to_search, optional(1) STRING lexical_search_query_column, optional(1) PROTO<googlesql_test.TestApproxDistanceFunctionOptionsProto> options, optional(1) INT64 top_k, optional(1) STRING distance_type, optional(1) DOUBLE max_distance) -> ANY TABLE
==

# implicit query_column_to_search and lexical_search_query_column
SELECT * FROM hybrid_vector_search(
  TABLE base_table,
  'embedding',
  TABLE query_table,
  lexical_search_columns => ['string_col']
)
--
QueryStmt
+-output_column_list=
| +-hybrid_vector_search.query#9 AS query [STRUCT<id INT64, query_embedding ARRAY<DOUBLE>, embedding ARRAY<DOUBLE>, float_embedding ARRAY<FLOAT>, string_query_col STRING>]
| +-hybrid_vector_search.base#10 AS base [STRUCT<id INT64, embedding ARRAY<DOUBLE>, string_col STRING>]
| +-hybrid_vector_search.distance#11 AS distance [DOUBLE]
+-query=
  +-ProjectScan
    +-column_list=hybrid_vector_search.[query#9, base#10, distance#11]
    +-input_scan=
      +-TVFScan
        +-column_list=hybrid_vector_search.[query#9, base#10, distance#11]
        +-tvf=GoogleSQL:hybrid_vector_search
        +-signature=(TABLE<id INT64, embedding ARRAY<DOUBLE>, string_col STRING>, literal STRING, TABLE<id INT64, query_embedding ARRAY<DOUBLE>, embedding ARRAY<DOUBLE>, float_embedding ARRAY<FLOAT>, string_query_col STRING>, ARRAY<STRING>, null STRING, null STRING, null PROTO<googlesql_test.TestApproxDistanceFunctionOptionsProto>, literal INT64, literal STRING, null DOUBLE) -> TABLE<query STRUCT<id INT64, query_embedding ARRAY<DOUBLE>, embedding ARRAY<DOUBLE>, float_embedding ARRAY<FLOAT>, string_query_col STRING>, base STRUCT<id INT64, embedding ARRAY<DOUBLE>, string_col STRING>, distance DOUBLE>
        +-argument_list=
        | +-FunctionArgument
        | | +-scan=
        | | | +-TableScan(column_list=base_table.[id#1, embedding#2, string_col#3], node_source="table_clause", table=base_table, column_index_list=[0, 1, 2])
        | | +-argument_column_list=base_table.[id#1, embedding#2, string_col#3]
        | +-FunctionArgument
        | | +-expr=
