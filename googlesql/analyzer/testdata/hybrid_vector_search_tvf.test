# Tests for HYBRID_VECTOR_SEARCH TVF.
#
# Similar to approx_distance_functions for supplied arguments, we would Nested
# serilization logic to run Java tests.
[default no_java]
[default language_features=DEV]
[default no_enable_literal_replacement]
# Disable literal replacement for HYBRID_VECTOR_SEARCH TVF because argument options
# is an immutable constant.

# Basic call with required and optional arguments
SELECT * FROM hybrid_vector_search(
  TABLE base_table,
  'embedding',
  TABLE query_table,
  lexical_search_columns => ['string_col'],
  query_column_to_search => 'query_embedding',
  lexical_search_query_column => 'string_query_col'
)
--
QueryStmt
+-output_column_list=
| +-hybrid_vector_search.query#9 AS query [STRUCT<id INT64, query_embedding ARRAY<DOUBLE>, embedding ARRAY<DOUBLE>, float_embedding ARRAY<FLOAT>, string_query_col STRING>]
| +-hybrid_vector_search.base#10 AS base [STRUCT<id INT64, embedding ARRAY<DOUBLE>, string_col STRING>]
| +-hybrid_vector_search.distance#11 AS distance [DOUBLE]
+-query=
  +-ProjectScan
    +-column_list=hybrid_vector_search.[query#9, base#10, distance#11]
    +-input_scan=
      +-TVFScan
        +-column_list=hybrid_vector_search.[query#9, base#10, distance#11]
        +-tvf=GoogleSQL:hybrid_vector_search
        +-signature=(TABLE<id INT64, embedding ARRAY<DOUBLE>, string_col STRING>, literal STRING, TABLE<id INT64, query_embedding ARRAY<DOUBLE>, embedding ARRAY<DOUBLE>, float_embedding ARRAY<FLOAT>, string_query_col STRING>, ARRAY<STRING>, literal STRING, literal STRING, null PROTO<googlesql_test.TestApproxDistanceFunctionOptionsProto>, literal INT64, literal STRING, null DOUBLE) -> TABLE<query STRUCT<id INT64, query_embedding ARRAY<DOUBLE>, embedding ARRAY<DOUBLE>, float_embedding ARRAY<FLOAT>, string_query_col STRING>, base STRUCT<id INT64, embedding ARRAY<DOUBLE>, string_col STRING>, distance DOUBLE>
        +-argument_list=
        | +-FunctionArgument
        | | +-scan=
        | | | +-TableScan(column_list=base_table.[id#1, embedding#2, string_col#3], node_source="table_clause", table=base_table, column_index_list=[0, 1, 2])
        | | +-argument_column_list=base_table.[id#1, embedding#2, string_col#3]
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=STRING, value="embedding")
        | +-FunctionArgument
        | | +-scan=
        | | | +-TableScan(column_list=query_table.[id#4, query_embedding#5, embedding#6, float_embedding#7, string_query_col#8], node_source="table_clause", table=query_table, column_index_list=[0, 1, 2, 3, 4])
        | | +-argument_column_list=query_table.[id#4, query_embedding#5, embedding#6, float_embedding#7, string_query_col#8]
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=ARRAY<STRING>, value=["string_col"])
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=STRING, value="query_embedding")
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=STRING, value="string_query_col")
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=PROTO<googlesql_test.TestApproxDistanceFunctionOptionsProto>, value=NULL, preserve_in_literal_remover=TRUE)
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=INT64, value=10)
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=STRING, value="EUCLIDEAN")
        | +-FunctionArgument
        |   +-expr=
        |     +-Literal(type=DOUBLE, value=NULL)
        +-column_index_list=[0, 1, 2]
        +-function_call_signature=(ANY TABLE, STRING column_to_search, ANY TABLE, ARRAY<STRING> lexical_search_columns, optional(1) STRING query_column_to_search, optional(1) STRING lexical_search_query_column, optional(1) PROTO<googlesql_test.TestApproxDistanceFunctionOptionsProto> options, optional(1) INT64 top_k, optional(1) STRING distance_type, optional(1) DOUBLE max_distance) -> ANY TABLE
==

# Call with all arguments
SELECT * FROM hybrid_vector_search(
  TABLE base_table,
  'embedding',
  TABLE query_table,
  lexical_search_columns => ['string_col'],
  query_column_to_search => 'query_embedding',
  lexical_search_query_column => 'string_query_col',
  top_k => 5,
  distance_type => 'COSINE',
  max_distance => 0.8,
  options => new googlesql_test.TestApproxDistanceFunctionOptionsProto(1 as key, "value2" as value)
)
--
QueryStmt
+-output_column_list=
| +-hybrid_vector_search.query#9 AS query [STRUCT<id INT64, query_embedding ARRAY<DOUBLE>, embedding ARRAY<DOUBLE>, float_embedding ARRAY<FLOAT>, string_query_col STRING>]
| +-hybrid_vector_search.base#10 AS base [STRUCT<id INT64, embedding ARRAY<DOUBLE>, string_col STRING>]
| +-hybrid_vector_search.distance#11 AS distance [DOUBLE]
+-query=
  +-ProjectScan
    +-column_list=hybrid_vector_search.[query#9, base#10, distance#11]
    +-input_scan=
      +-TVFScan
        +-column_list=hybrid_vector_search.[query#9, base#10, distance#11]
        +-tvf=GoogleSQL:hybrid_vector_search
        +-signature=(TABLE<id INT64, embedding ARRAY<DOUBLE>, string_col STRING>, literal STRING, TABLE<id INT64, query_embedding ARRAY<DOUBLE>, embedding ARRAY<DOUBLE>, float_embedding ARRAY<FLOAT>, string_query_col STRING>, ARRAY<STRING>, literal STRING, literal STRING, PROTO<googlesql_test.TestApproxDistanceFunctionOptionsProto>, literal INT64, literal STRING, literal DOUBLE) -> TABLE<query STRUCT<id INT64, query_embedding ARRAY<DOUBLE>, embedding ARRAY<DOUBLE>, float_embedding ARRAY<FLOAT>, string_query_col STRING>, base STRUCT<id INT64, embedding ARRAY<DOUBLE>, string_col STRING>, distance DOUBLE>
        +-argument_list=
        | +-FunctionArgument
        | | +-scan=
        | | | +-TableScan(column_list=base_table.[id#1, embedding#2, string_col#3], node_source="table_clause", table=base_table, column_index_list=[0, 1, 2])
        | | +-argument_column_list=base_table.[id#1, embedding#2, string_col#3]
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=STRING, value="embedding")
        | +-FunctionArgument
        | | +-scan=
        | | | +-TableScan(column_list=query_table.[id#4, query_embedding#5, embedding#6, float_embedding#7, string_query_col#8], node_source="table_clause", table=query_table, column_index_list=[0, 1, 2, 3, 4])
        | | +-argument_column_list=query_table.[id#4, query_embedding#5, embedding#6, float_embedding#7, string_query_col#8]
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=ARRAY<STRING>, value=["string_col"])
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=STRING, value="query_embedding")
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=STRING, value="string_query_col")
        | +-FunctionArgument
        | | +-expr=
        | |   +-MakeProto
        | |     +-type=PROTO<googlesql_test.TestApproxDistanceFunctionOptionsProto>
        | |     +-field_list=
        | |       +-key := Literal(type=INT64, value=1)
        | |       +-value := Literal(type=STRING, value="value2")
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=INT64, value=5)
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=STRING, value="COSINE")
        | +-FunctionArgument
        |   +-expr=
        |     +-Literal(type=DOUBLE, value=0.8, float_literal_id=1)
        +-column_index_list=[0, 1, 2]
        +-function_call_signature=(ANY TABLE, STRING column_to_search, ANY TABLE, ARRAY<STRING> lexical_search_columns, optional(1) STRING query_column_to_search, optional(1) STRING lexical_search_query_column, optional(1) PROTO<googlesql_test.TestApproxDistanceFunctionOptionsProto> options, optional(1) INT64 top_k, optional(1) STRING distance_type, optional(1) DOUBLE max_distance) -> ANY TABLE
==

# query table as SELECT query
SELECT * FROM hybrid_vector_search(
  TABLE base_table,
  'embedding',
  (SELECT query_embedding, string_query_col FROM query_table),
  lexical_search_columns => ['string_col'],
  query_column_to_search => 'query_embedding',
  lexical_search_query_column => 'string_query_col',
  options => new googlesql_test.TestApproxDistanceFunctionOptionsProto(),
  top_k => 5,
  distance_type => 'COSINE',
  max_distance => 0.8
)
--
QueryStmt
+-output_column_list=
| +-hybrid_vector_search.query#9 AS query [STRUCT<query_embedding ARRAY<DOUBLE>, string_query_col STRING>]
| +-hybrid_vector_search.base#10 AS base [STRUCT<id INT64, embedding ARRAY<DOUBLE>, string_col STRING>]
| +-hybrid_vector_search.distance#11 AS distance [DOUBLE]
+-query=
  +-ProjectScan
    +-column_list=hybrid_vector_search.[query#9, base#10, distance#11]
    +-input_scan=
      +-TVFScan
        +-column_list=hybrid_vector_search.[query#9, base#10, distance#11]
        +-tvf=GoogleSQL:hybrid_vector_search
        +-signature=(TABLE<id INT64, embedding ARRAY<DOUBLE>, string_col STRING>, literal STRING, TABLE<query_embedding ARRAY<DOUBLE>, string_query_col STRING>, ARRAY<STRING>, literal STRING, literal STRING, PROTO<googlesql_test.TestApproxDistanceFunctionOptionsProto>, literal INT64, literal STRING, literal DOUBLE) -> TABLE<query STRUCT<query_embedding ARRAY<DOUBLE>, string_query_col STRING>, base STRUCT<id INT64, embedding ARRAY<DOUBLE>, string_col STRING>, distance DOUBLE>
        +-argument_list=
        | +-FunctionArgument
        | | +-scan=
        | | | +-TableScan(column_list=base_table.[id#1, embedding#2, string_col#3], node_source="table_clause", table=base_table, column_index_list=[0, 1, 2])
        | | +-argument_column_list=base_table.[id#1, embedding#2, string_col#3]
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=STRING, value="embedding")
        | +-FunctionArgument
        | | +-scan=
        | | | +-ProjectScan
        | | |   +-column_list=query_table.[query_embedding#5, string_query_col#8]
        | | |   +-input_scan=
        | | |     +-TableScan(column_list=query_table.[query_embedding#5, string_query_col#8], table=query_table, column_index_list=[1, 4])
        | | +-argument_column_list=query_table.[query_embedding#5, string_query_col#8]
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=ARRAY<STRING>, value=["string_col"])
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=STRING, value="query_embedding")
        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=STRING, value="string_query_col")
