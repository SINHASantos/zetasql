        | +-FunctionArgument
        | | +-expr=
        | |   +-Literal(type=STRING, value="COSINE")
        | +-FunctionArgument
        |   +-expr=
        |     +-Literal(type=DOUBLE, value=0.8, float_literal_id=1)
        +-column_index_list=[0, 1, 2]
        +-function_call_signature=(ANY TABLE, STRING column_to_search, ANY TABLE, ARRAY<STRING> lexical_search_columns, optional(1) STRING query_column_to_search, optional(1) STRING lexical_search_query_column, optional(1) PROTO<googlesql_test.TestApproxDistanceFunctionOptionsProto> options, optional(1) INT64 top_k, optional(1) STRING distance_type, optional(1) DOUBLE max_distance) -> ANY TABLE
