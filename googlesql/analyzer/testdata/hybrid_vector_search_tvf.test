# Call with alias

WITH base_table AS (
  SELECT 1 AS _INDEX_LEAF_ID, ARRAY<FLOAT>[1.0, 2.0, 3.0] AS EmbeddingColumn, 'text_base' AS StrCol
)
SELECT base._INDEX_LEAF_ID, distance
FROM HYBRID_VECTOR_SEARCH(
   (
    SELECT _INDEX_LEAF_ID, EmbeddingColumn AS embedding, StrCol AS string_col
    FROM base_table
  ), -- Inlined base_table
  'embedding',
  query_value => ARRAY<FLOAT>[0.1, 0.2, 0.3],
  lexical_search_columns => ['string_col'],
  lexical_search_query_value => 'text_query',
  top_k => 10 /* @top_k */,
  distance_type => 'DOT_PRODUCT')
