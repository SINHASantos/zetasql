# Set operation with unannotated vector branch first followed by annotated vector branch.
SELECT ENCODE_VECTOR(@test_param_array_float) AS v
UNION ALL
SELECT ENCODE_VECTOR([1.0, 2.0], 2, "FLOAT32") AS v
--
QueryStmt
+-output_column_list=
| +-$union_all.v#3{VectorLength:-1} AS v [VECTOR]
+-query=
  +-SetOperationScan
    +-column_list=[$union_all.v#3{VectorLength:-1}]
