# Set operation with unannotated column reference branch first followed by annotated branch.
WITH t AS (
  SELECT ENCODE_VECTOR(@test_param_array_float) AS v_unannotated,
         ENCODE_VECTOR([1.0, 2.0], 2, "FLOAT32") AS v_annotated
)
SELECT v_unannotated AS v FROM t
UNION ALL
SELECT v_annotated AS v FROM t
--
QueryStmt
+-output_column_list=
| +-$union_all.v#7{VectorLength:-1} AS v [VECTOR]
+-query=
  +-WithScan
    +-column_list=[$union_all.v#7{VectorLength:-1}]
    +-with_entry_list=
    | +-WithEntry
    |   +-with_query_name="t"
    |   +-with_subquery=
    |     +-ProjectScan
    |       +-column_list=t.[v_unannotated#1, v_annotated#2]
    |       +-expr_list=
    |       | +-v_unannotated#1 :=
    |       | | +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(0) INT64, optional(0) STRING) -> VECTOR)
    |       | |   +-type_annotation_map={VectorLength:-1}
    |       | |   +-Parameter(type=ARRAY<FLOAT>, name="test_param_array_float")
    |       | +-v_annotated#2 :=
    |       |   +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |       |     +-type_annotation_map={VectorLength:2}
    |       |     +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
    |       |     +-Literal(type=INT64, value=2)
    |       |     +-Literal(type=STRING, value="FLOAT32")
    |       +-input_scan=
    |         +-SingleRowScan
    +-query=
      +-SetOperationScan
        +-column_list=[$union_all.v#7{VectorLength:-1}]
        +-op_type=UNION_ALL
        +-input_item_list=
          +-SetOperationItem
          | +-scan=
          | | +-ProjectScan
          | |   +-column_list=[t.v_unannotated#3{VectorLength:-1}]
          | |   +-input_scan=
          | |     +-WithRefScan(column_list=t.[v_unannotated#3, v_annotated#4], with_query_name="t")
          | +-output_column_list=[t.v_unannotated#3{VectorLength:-1}]
          +-SetOperationItem
            +-scan=
            | +-ProjectScan
            |   +-column_list=[t.v_annotated#6{VectorLength:2}]
            |   +-input_scan=
            |     +-WithRefScan(column_list=t.[v_unannotated#5, v_annotated#6], with_query_name="t")
