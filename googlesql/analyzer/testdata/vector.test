    |       | |         +-Literal(type=INT64, value=3)
    |       | |         +-Literal(type=STRING, value="FLOAT32")
    |       | +-s_annotated2#3 :=
    |       |   +-MakeStruct
    |       |     +-type=STRUCT<v VECTOR, arr ARRAY<VECTOR>>
    |       |     +-type_annotation_map=<{VectorLength:5},<{VectorLength:3}>>
    |       |     +-field_list=
    |       |       +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |       |       | +-type_annotation_map={VectorLength:5}
