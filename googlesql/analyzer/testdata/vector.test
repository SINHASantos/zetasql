###############
# DOT_PRODUCT #
###############

SELECT DOT_PRODUCT(ENCODE_VECTOR([1.0, 2.0]), ENCODE_VECTOR([3.0, 4.0]))
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1 AS `$col1` [DOUBLE]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#1]
    +-expr_list=
    | +-$col1#1 :=
    |   +-FunctionCall(GoogleSQL:dot_product(VECTOR, VECTOR) -> DOUBLE)
