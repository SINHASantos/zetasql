# Set operation on STRUCT<v1 VECTOR, v2 VECTOR> where one branch has v1 annotated and v2 unannotated,
# and the other branch has v1 conflicting and v2 annotated.
WITH t AS (
  SELECT
    STRUCT(
      ENCODE_VECTOR([1.0, 2.0], 2, "FLOAT32") AS v1,
      ENCODE_VECTOR(@test_param_array_float) AS v2
    ) AS s1,
    STRUCT(
      ENCODE_VECTOR([1.0, 2.0, 3.0], 3, "FLOAT32") AS v1,
      ENCODE_VECTOR([1.0, 2.0, 3.0, 4.0], 4, "FLOAT32") AS v2
    ) AS s2
)
SELECT s1 AS s FROM t
UNION ALL
SELECT s2 AS s FROM t
--
QueryStmt
+-output_column_list=
| +-$union_all.s#7<{VectorLength:-1},{VectorLength:-1}> AS s [STRUCT<v1 VECTOR, v2 VECTOR>]
+-query=
  +-WithScan
    +-column_list=[$union_all.s#7<{VectorLength:-1},{VectorLength:-1}>]
    +-with_entry_list=
    | +-WithEntry
    |   +-with_query_name="t"
    |   +-with_subquery=
    |     +-ProjectScan
    |       +-column_list=t.[s1#1, s2#2]
    |       +-expr_list=
    |       | +-s1#1 :=
    |       | | +-MakeStruct
    |       | |   +-type=STRUCT<v1 VECTOR, v2 VECTOR>
    |       | |   +-type_annotation_map=<{VectorLength:2},{VectorLength:-1}>
    |       | |   +-field_list=
    |       | |     +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |       | |     | +-type_annotation_map={VectorLength:2}
    |       | |     | +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
    |       | |     | +-Literal(type=INT64, value=2)
    |       | |     | +-Literal(type=STRING, value="FLOAT32")
    |       | |     +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(0) INT64, optional(0) STRING) -> VECTOR)
    |       | |       +-type_annotation_map={VectorLength:-1}
    |       | |       +-Parameter(type=ARRAY<FLOAT>, name="test_param_array_float")
    |       | +-s2#2 :=
    |       |   +-MakeStruct
    |       |     +-type=STRUCT<v1 VECTOR, v2 VECTOR>
    |       |     +-type_annotation_map=<{VectorLength:3},{VectorLength:4}>
    |       |     +-field_list=
    |       |       +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |       |       | +-type_annotation_map={VectorLength:3}
    |       |       | +-Literal(type=ARRAY<FLOAT>, value=[1, 2, 3])
    |       |       | +-Literal(type=INT64, value=3)
    |       |       | +-Literal(type=STRING, value="FLOAT32")
    |       |       +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |       |         +-type_annotation_map={VectorLength:4}
    |       |         +-Literal(type=ARRAY<FLOAT>, value=[1, 2, 3, 4])
    |       |         +-Literal(type=INT64, value=4)
    |       |         +-Literal(type=STRING, value="FLOAT32")
    |       +-input_scan=
    |         +-SingleRowScan
    +-query=
      +-SetOperationScan
        +-column_list=[$union_all.s#7<{VectorLength:-1},{VectorLength:-1}>]
        +-op_type=UNION_ALL
        +-input_item_list=
          +-SetOperationItem
          | +-scan=
          | | +-ProjectScan
          | |   +-column_list=[t.s1#3<{VectorLength:2},{VectorLength:-1}>]
          | |   +-input_scan=
          | |     +-WithRefScan(column_list=t.[s1#3, s2#4], with_query_name="t")
          | +-output_column_list=[t.s1#3<{VectorLength:2},{VectorLength:-1}>]
          +-SetOperationItem
            +-scan=
            | +-ProjectScan
            |   +-column_list=[t.s2#6<{VectorLength:3},{VectorLength:4}>]
            |   +-input_scan=
            |     +-WithRefScan(column_list=t.[s1#5, s2#6], with_query_name="t")
            +-output_column_list=[t.s2#6<{VectorLength:3},{VectorLength:4}>]
==

# UNION DISTINCT is disallowed for VECTOR because VECTOR does not support grouping.
SELECT ENCODE_VECTOR([1.0, 2.0]) AS v
UNION DISTINCT
SELECT ENCODE_VECTOR([3.0, 4.0]) AS v
--
ERROR: Column 1 in UNION DISTINCT has type that does not support set operation comparisons: VECTOR [at 3:1]
SELECT ENCODE_VECTOR([3.0, 4.0]) AS v
^
==

# Recursive scan with vector column.
WITH RECURSIVE t AS (
  SELECT 1 AS id, ENCODE_VECTOR([1.0, 2.0], 2, "FLOAT32") AS v
  UNION ALL
  SELECT id + 1, v FROM t WHERE id < 10
)
SELECT v FROM t
--
QueryStmt
+-output_column_list=
| +-t.v#9{VectorLength:2} AS v [VECTOR]
+-query=
  +-WithScan
    +-column_list=[t.v#9{VectorLength:2}]
    +-with_entry_list=
    | +-WithEntry
    |   +-with_query_name="t"
    |   +-with_subquery=
    |     +-RecursiveScan
    |       +-column_list=$union_all.[id#3, v#4]
    |       +-op_type=UNION_ALL
    |       +-non_recursive_term=
    |       | +-SetOperationItem
    |       |   +-scan=
    |       |   | +-ProjectScan
    |       |   |   +-column_list=$union_all1.[id#1, v#2]
    |       |   |   +-expr_list=
    |       |   |   | +-id#1 := Literal(type=INT64, value=1)
    |       |   |   | +-v#2 :=
    |       |   |   |   +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |       |   |   |     +-type_annotation_map={VectorLength:2}
    |       |   |   |     +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
    |       |   |   |     +-Literal(type=INT64, value=2)
    |       |   |   |     +-Literal(type=STRING, value="FLOAT32")
    |       |   |   +-input_scan=
    |       |   |     +-SingleRowScan
    |       |   +-output_column_list=$union_all1.[id#1, v#2]
    |       +-recursive_term=
    |         +-SetOperationItem
    |           +-scan=
    |           | +-ProjectScan
    |           |   +-column_list=[$union_all2.$col1#7, t.v#6{VectorLength:2}]
    |           |   +-expr_list=
    |           |   | +-$col1#7 :=
    |           |   |   +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |           |   |     +-ColumnRef(type=INT64, column=t.id#5)
    |           |   |     +-Literal(type=INT64, value=1)
    |           |   +-input_scan=
    |           |     +-FilterScan
    |           |       +-column_list=t.[id#5, v#6]
    |           |       +-input_scan=
    |           |       | +-RecursiveRefScan(column_list=t.[id#5, v#6])
    |           |       +-filter_expr=
    |           |         +-FunctionCall(GoogleSQL:$less(INT64, INT64) -> BOOL)
    |           |           +-ColumnRef(type=INT64, column=t.id#5)
    |           |           +-Literal(type=INT64, value=10)
    |           +-output_column_list=[$union_all2.$col1#7, t.v#6{VectorLength:2}]
    +-query=
    | +-ProjectScan
    |   +-column_list=[t.v#9{VectorLength:2}]
    |   +-input_scan=
    |     +-WithRefScan(column_list=t.[id#8, v#9], with_query_name="t")
    +-recursive=TRUE
==

# Recursive scan with conflicting vector length in recursive term.
WITH RECURSIVE t AS (
  SELECT 1 AS id, ENCODE_VECTOR([1.0, 2.0], 2, "FLOAT32") AS v
  UNION ALL
  SELECT id + 1, ENCODE_VECTOR([1.0, 2.0, 3.0], 3, "FLOAT32") AS v FROM t WHERE id < 10
)
SELECT v FROM t
--
QueryStmt
+-output_column_list=
| +-t.v#10{VectorLength:-1} AS v [VECTOR]
+-query=
  +-WithScan
    +-column_list=[t.v#10{VectorLength:-1}]
    +-with_entry_list=
    | +-WithEntry
    |   +-with_query_name="t"
    |   +-with_subquery=
    |     +-RecursiveScan
    |       +-column_list=$union_all.[id#3, v#4]
    |       +-op_type=UNION_ALL
    |       +-non_recursive_term=
    |       | +-SetOperationItem
    |       |   +-scan=
    |       |   | +-ProjectScan
    |       |   |   +-column_list=$union_all1.[id#1, v#2]
    |       |   |   +-expr_list=
    |       |   |   | +-id#1 := Literal(type=INT64, value=1)
    |       |   |   | +-v#2 :=
    |       |   |   |   +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |       |   |   |     +-type_annotation_map={VectorLength:2}
    |       |   |   |     +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
    |       |   |   |     +-Literal(type=INT64, value=2)
    |       |   |   |     +-Literal(type=STRING, value="FLOAT32")
    |       |   |   +-input_scan=
    |       |   |     +-SingleRowScan
    |       |   +-output_column_list=$union_all1.[id#1, v#2]
    |       +-recursive_term=
    |         +-SetOperationItem
    |           +-scan=
    |           | +-ProjectScan
    |           |   +-column_list=$union_all2.[$col1#7, v#8]
    |           |   +-expr_list=
    |           |   | +-$col1#7 :=
    |           |   | | +-FunctionCall(GoogleSQL:$add(INT64, INT64) -> INT64)
    |           |   | |   +-ColumnRef(type=INT64, column=t.id#5)
    |           |   | |   +-Literal(type=INT64, value=1)
    |           |   | +-v#8 :=
    |           |   |   +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(1) STRING) -> VECTOR)
    |           |   |     +-type_annotation_map={VectorLength:3}
    |           |   |     +-Literal(type=ARRAY<FLOAT>, value=[1, 2, 3])
    |           |   |     +-Literal(type=INT64, value=3)
    |           |   |     +-Literal(type=STRING, value="FLOAT32")
    |           |   +-input_scan=
    |           |     +-FilterScan
    |           |       +-column_list=t.[id#5, v#6]
    |           |       +-input_scan=
    |           |       | +-RecursiveRefScan(column_list=t.[id#5, v#6])
    |           |       +-filter_expr=
    |           |         +-FunctionCall(GoogleSQL:$less(INT64, INT64) -> BOOL)
    |           |           +-ColumnRef(type=INT64, column=t.id#5)
    |           |           +-Literal(type=INT64, value=10)
    |           +-output_column_list=$union_all2.[$col1#7, v#8]
    +-query=
    | +-ProjectScan
    |   +-column_list=[t.v#10{VectorLength:-1}]
    |   +-input_scan=
    |     +-WithRefScan(column_list=t.[id#9, v#10], with_query_name="t")
    +-recursive=TRUE
==

