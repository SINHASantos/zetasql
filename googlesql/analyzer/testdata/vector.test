# Test conditional evaluations with IFERROR, SAFE, and CASE.
SELECT
  IFERROR(ENCODE_VECTOR([1.0, 2.0], 100), NULL),
  SAFE.ENCODE_VECTOR([1.0, 2.0], 100),
  IF(false, ENCODE_VECTOR([1.0, 2.0], 100), NULL),
  CASE
    WHEN TRUE THEN ENCODE_VECTOR([1.0, 2.0])
    ELSE NULL
    END
--
QueryStmt
+-output_column_list=
| +-$query.$col1#1{VectorLength:100} AS `$col1` [VECTOR]
| +-$query.$col2#2{VectorLength:100} AS `$col2` [VECTOR]
| +-$query.$col3#3{VectorLength:100} AS `$col3` [VECTOR]
| +-$query.$col4#4{VectorLength:2} AS `$col4` [VECTOR]
+-query=
  +-ProjectScan
    +-column_list=$query.[$col1#1, $col2#2, $col3#3, $col4#4]
    +-expr_list=
    | +-$col1#1 :=
    | | +-FunctionCall(GoogleSQL:iferror(VECTOR, VECTOR) -> VECTOR)
    | |   +-type_annotation_map={VectorLength:100}
    | |   +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(0) STRING) -> VECTOR)
    | |   | +-type_annotation_map={VectorLength:100}
    | |   | +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
    | |   | +-Literal(type=INT64, value=100)
    | |   +-Literal(type=VECTOR, value=NULL)
    | +-$col2#2 :=
    | | +-FunctionCall({SAFE_ERROR_MODE} GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(0) STRING) -> VECTOR)
    | |   +-type_annotation_map={VectorLength:100}
    | |   +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
    | |   +-Literal(type=INT64, value=100)
    | +-$col3#3 :=
    | | +-FunctionCall(GoogleSQL:if(BOOL, VECTOR, VECTOR) -> VECTOR)
    | |   +-type_annotation_map={VectorLength:100}
    | |   +-Literal(type=BOOL, value=false)
    | |   +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(1) INT64, optional(0) STRING) -> VECTOR)
    | |   | +-type_annotation_map={VectorLength:100}
    | |   | +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
    | |   | +-Literal(type=INT64, value=100)
    | |   +-Literal(type=VECTOR, value=NULL)
    | +-$col4#4 :=
    |   +-FunctionCall(GoogleSQL:$case_no_value(repeated(1) BOOL, repeated(1) VECTOR, VECTOR) -> VECTOR)
    |     +-type_annotation_map={VectorLength:2}
    |     +-Literal(type=BOOL, value=true)
    |     +-FunctionCall(GoogleSQL:encode_vector(ARRAY<FLOAT>, optional(0) INT64, optional(0) STRING) -> VECTOR)
    |     | +-type_annotation_map={VectorLength:2}
    |     | +-Literal(type=ARRAY<FLOAT>, value=[1, 2])
    |     +-Literal(type=VECTOR, value=NULL)
    +-input_scan=
      +-SingleRowScan
==

# Test conditional evaluations with standalone NULL vs unannotated expression.
SELECT
  IF(false, ENCODE_VECTOR([1.0, 2.0], 100), NULL),
  IF(false, ENCODE_VECTOR([1.0, 2.0], 100), ENCODE_VECTOR(@test_param_array_float))
