# ENCODE_VECTOR does not allow passing ARRAY<DOUBLE> as input.
SELECT VECTOR_LENGTH(ENCODE_VECTOR(ARRAY<DOUBLE>[1.7e308]));
--
ERROR: No matching signature for function ENCODE_VECTOR
  Argument types: ARRAY<DOUBLE>
  Signature: ENCODE_VECTOR(ARRAY<FLOAT>, [INT64], [STRING])
    Argument 1: Unable to coerce type ARRAY<DOUBLE> to expected type ARRAY<FLOAT> [at 1:22]
SELECT VECTOR_LENGTH(ENCODE_VECTOR(ARRAY<DOUBLE>[1.7e308]));
                     ^
==

# ENCODE_VECTOR with an array literal containing an overflowed float32.
SELECT ENCODE_VECTOR([1.7e308]);
--
ERROR: Could not cast literal [1.7e+308] to type ARRAY<FLOAT> [at 1:22]
SELECT ENCODE_VECTOR([1.7e308]);
                     ^
==

