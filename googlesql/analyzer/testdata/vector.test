# Table with generated column of VECTOR
[no_enable_literal_replacement]
CREATE TABLE t(arr ARRAY<FLOAT>, v VECTOR(3, 'FLOAT32') AS (ENCODE_VECTOR(arr, 3, 'FLOAT32')))
--
CreateTableStmt
+-name_path=t
+-column_definition_list=
  +-ColumnDefinition(name="arr", type=ARRAY<FLOAT>, column=t.arr#1)
  +-ColumnDefinition
    +-name="v"
