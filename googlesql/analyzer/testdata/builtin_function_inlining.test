# Test ARRAY_TRANSFORM with multiple captured outer variables.
# When inlined via substitute.cc, multiple captured variables are collected
# into the subquery parameter_list.
[enabled_ast_rewrites=ALL]
SELECT ARRAY_TRANSFORM([1, 2], x -> x + a + b + c)
FROM (SELECT 1 AS a, 2 AS b, 3 AS c);
--

QueryStmt
+-output_column_list=
| +-$query.$col1#5 AS `$col1` [ARRAY<INT64>]
+-query=
  +-ProjectScan
    +-column_list=[$query.$col1#5]
