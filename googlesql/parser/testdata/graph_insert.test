# DML Terminality: Chaining multiple INSERT statements is not supported yet.
GRAPH my.graph.name
INSERT (a:LABEL1)
INSERT (b:LABEL2)
--
ERROR: Syntax error: Expected end of input but got keyword INSERT [at 3:1]
INSERT (b:LABEL2)
^
==

