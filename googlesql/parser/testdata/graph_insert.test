          Identifier(name) [15-19] [name]
        GqlOperatorList [20-37] [INSERT (a)-[]->()]
          GqlOperatorList [20-37] [INSERT (a)-[]->()]
            GqlInsert [20-37] [INSERT (a)-[]->()]
              GraphInsertPathPattern [27-37] [(a)-[]->()]
                GraphInsertNodePattern [27-30] [(a)]
                  GraphInsertElementPatternFiller [28-29] [a]
                    Identifier(a) [28-29] [a]
                GraphInsertEdgePattern [30-35] [-[]->]
                  GraphInsertElementPatternFiller [32-32] []
                GraphInsertNodePattern [35-37] [()]
                  GraphInsertElementPatternFiller [36-36] []
