QueryStatement [113-210] [select * from...1 AS one )]
  Query [113-210] [select * from...1 AS one )]
    Select [113-210] [select * from...1 AS one )]
      SelectList [120-121] [*]
        SelectColumn [120-121] [*]
          Star(*) [120-121] [*]
      FromClause [122-210] [from graph_table...1 AS one )]
        GraphTableQuery [127-210] [graph_table...1 AS one )]
          PathExpression [142-155] [my.graph.name]
            Identifier(my) [142-144] [my]
            Identifier(graph) [145-150] [graph]
            Identifier(name) [151-155] [name]
          GqlOperatorList [158-208] [INSERT (a:...RETURN 1 AS one]
            GqlOperatorList [158-208] [INSERT (a:...RETURN 1 AS one]
              GqlInsert [158-190] [INSERT (a:...: "John"})]
                GraphInsertPathPattern [165-190] [(a:Person {name: "John"})]
                  GraphInsertNodePattern [165-190] [(a:Person {name: "John"})]
                    GraphInsertElementPatternFiller [166-189] [a:Person {name: "John"}]
                      Identifier(a) [166-167] [a]
                      GraphLabelFilter [167-174] [:Person]
                        GraphElementLabel [168-174] [Person]
                          Identifier(Person) [168-174] [Person]
                      GraphPropertySpecification [175-189] [{name: "John"}]
                        GraphPropertyNameAndValue [176-188] [name: "John"]
                          Identifier(name) [176-180] [name]
                          StringLiteral [182-188] ["John"]
                            StringLiteralComponent("John") [182-188] ["John"]
              GqlReturn [193-208] [RETURN 1 AS one]
                Select [200-208] [1 AS one]
                  SelectList [200-208] [1 AS one]
                    SelectColumn [200-208] [1 AS one]
                      IntLiteral(1) [200-201] [1]
                      Alias [202-208] [AS one]
                        Identifier(one) [205-208] [one]
--
SELECT
  *
FROM
  GRAPH_TABLE(
    my.graph.name
    INSERT
      (a IS Person { name : "John" })
    RETURN
      1 AS one
  )
==

# INSERT in a top-level GRAPH statement.
# FINISH syntax is not supported.
GRAPH my.graph.name
INSERT (a:Person {name: "John"})
{{FINISH|RETURN 1 AS one|}}
--
ALTERNATION GROUP: FINISH
--
ERROR: Syntax error: Expected end of input but got keyword FINISH [at 3:1]
FINISH
^
