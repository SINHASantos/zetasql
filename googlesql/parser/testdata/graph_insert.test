[default reserve_graph_table]
[default language_features=NONE,+SQL_GRAPH]

# INSERT is not allowed in places other than top-level GRAPH statement.
# But this will be rejected in resolver.
select * from graph_table(
  my.graph.name
  INSERT (a:Person {name: "John"})
  RETURN 1 AS one
)
