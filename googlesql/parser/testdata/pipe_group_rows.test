                PipeDistinct [200-211] [|> DISTINCT]
        GroupBy [216-230] [GROUP BY State]
          GroupingItem [225-230] [State]
            PathExpression [225-230] [State]
              Identifier(State) [225-230] [State]
--
FROM
  Transactions
|> AGGREGATE
     ARRAY(WITH
         group_rows() AS GROUP ROWS
       FROM
         group_rows()
       |> SELECT
            customer_id
       |> DISTINCT)
   GROUP BY State
