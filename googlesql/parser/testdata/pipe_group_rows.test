[default language_features=MAXIMUM,+WITH_GROUP_ROWS]

# Use group rows within subquery.
FROM Transactions
|> AGGREGATE ARRAY(WITH group_rows() AS GROUP ROWS
                   FROM group_rows()
                   |> SELECT customer_id
                   |> DISTINCT)
   GROUP BY State
