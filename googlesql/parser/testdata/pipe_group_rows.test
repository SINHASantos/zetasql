      Select [55-230] [AGGREGATE...GROUP BY State]
        SelectList [65-212] [ARRAY(WITH...DISTINCT)]
          SelectColumn [65-212] [ARRAY(WITH...DISTINCT)]
            ExpressionSubquery(modifier=ARRAY) [65-212] [ARRAY(WITH...DISTINCT)]
              Query [71-211] [WITH group_rows...> DISTINCT]
                WithClause [71-102] [WITH group_rows...GROUP ROWS]
                  WithClauseEntry [76-102] [group_rows() AS GROUP ROWS]
                    AliasedGroupRows [76-102] [group_rows() AS GROUP ROWS]
