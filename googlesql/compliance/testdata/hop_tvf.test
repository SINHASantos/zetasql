[required_features=INTERVAL_TYPE,TABLE_VALUED_FUNCTIONS,TUMBLE_HOP_TVFS]
[name=hop_null_value_table_and_field]
WITH ValueTable AS (
  SELECT AS STRUCT TIMESTAMP '2025-01-01 00:00:00+00' AS ts, 'a' AS val
  UNION ALL
  SELECT CAST(NULL AS STRUCT<ts TIMESTAMP, val STRING>)
  UNION ALL
  SELECT AS STRUCT CAST(NULL AS TIMESTAMP) AS ts, 'c' AS val
)
SELECT * FROM hop(TABLE ValueTable, "ts", INTERVAL 1 DAY, INTERVAL 1 DAY);
--
ARRAY<STRUCT<
        ts TIMESTAMP,
        val STRING,
        WINDOW_START TIMESTAMP,
        WINDOW_END TIMESTAMP
      >>
[unknown order:{NULL, NULL, NULL, NULL},
               {
                 2025-01-01 00:00:00+00,
                 "a",
                 2025-01-01 00:00:00+00,
                 2025-01-02 00:00:00+00
               },
               {NULL, "c", NULL, NULL}]
==
