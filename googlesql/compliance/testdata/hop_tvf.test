[required_features=INTERVAL_TYPE,TABLE_VALUED_FUNCTIONS,TUMBLE_HOP_TVFS]
[name=hop_proto_null_timestamp_val]
WITH TableWithNullProtoTimestamp AS (
  SELECT
    1 AS key,
    NEW googlesql_test.TestHopAndTumblePB(
      100 AS int32_val,
      TO_PROTO(TIMESTAMP '2025-01-01 00:00:00 UTC') AS timestamp_val
    ) AS ProtoColumn
  UNION ALL
  SELECT
    2 AS key,
    NEW googlesql_test.TestHopAndTumblePB(
      200 AS int32_val
    ) AS ProtoColumn
)
SELECT * FROM hop(TABLE TableWithNullProtoTimestamp, "ProtoColumn.timestamp_val", INTERVAL 1 DAY, INTERVAL 1 DAY);
--
ARRAY<STRUCT<
        key INT64,
        ProtoColumn PROTO<googlesql_test.TestHopAndTumblePB>,
        WINDOW_START TIMESTAMP,
        WINDOW_END TIMESTAMP
      >>
[unknown order:{1,
                {
                  int32_val: 100
                  timestamp_val {
                    seconds: 1735689600
                  }
                },
                2025-01-01 00:00:00+00,
                2025-01-02 00:00:00+00},
               {2, {int32_val: 200}, NULL, NULL}]

