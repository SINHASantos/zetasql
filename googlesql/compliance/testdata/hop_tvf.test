==
# Run-once semantics:
# This test tries to ensure that expressions provided as TVF arguments are
# evaluated exactly once. In particular, this is intended to check that the
# **HOP function rewriter** preserves run-once semantics.
#
# If window_size is evaluated once, we will get 30 distinct WINDOW_END values.
# If it's evaluated per row, some rows might get 60m and others 61m. Since the
# window step is 2m (even) and sizes are 60m (even) vs 61m (odd), the two sets
# of WINDOW_END values will be disjoint, yielding 30 + 30 = 60 distinct values.
[required_features=INTERVAL_TYPE,TABLE_VALUED_FUNCTIONS,TUMBLE_HOP_TVFS]
[name=hop_run_once_window_size]
WITH Events AS (
  SELECT TIMESTAMP '2025-09-01 05:05:00' AS ts
  FROM UNNEST(GENERATE_ARRAY(1, 20)) AS n
)
SELECT
  IF(windows_count = 30, 'Correct', 'Incorrect!')
FROM (
  SELECT count(distinct WINDOW_END) as windows_count
  FROM HOP(TABLE Events, 'ts', IF(RAND() > 0.5, INTERVAL '60' MINUTE, INTERVAL '61' MINUTE), INTERVAL '2' MINUTE)
)
--
ARRAY<STRUCT<STRING>>[{"Correct"}]
==
[required_features=INTERVAL_TYPE,TABLE_VALUED_FUNCTIONS,TUMBLE_HOP_TVFS,PIPES]
[name=hop_passthrough_namelist_and_rv]
WITH InputTable AS (
  SELECT TIMESTAMP '2025-01-01 10:00:00+00' AS ts, 'a' AS window_start, 10 AS window_end
  UNION ALL
  SELECT TIMESTAMP '2025-01-02 15:00:00+00' AS ts, 'b' AS window_start, 20 AS window_end
)
FROM InputTable AS RV
|> CALL hop("ts", INTERVAL 1 DAY, INTERVAL 1 DAY)
|> SELECT RV.window_start, RV.window_end, WINDOW_START, WINDOW_END;
--
ARRAY<STRUCT<
        window_start STRING,
        window_end INT64,
        WINDOW_START TIMESTAMP,
        WINDOW_END TIMESTAMP
      >>
[unknown order:{
                 "a",
                 10,
                 2025-01-01 00:00:00+00,
                 2025-01-02 00:00:00+00
               },
               {
                 "b",
                 20,
                 2025-01-02 00:00:00+00,
                 2025-01-03 00:00:00+00
               }]
